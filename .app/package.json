{
  "name": "astrosquad-station",
  "version": "1.0.0",
  "description": "AstroSquad Research Station Electron App - Zero-Install Git, Document Viewers, and Doppler Shift Aesthetic",
  "author": "The Geek Shed (thegeekshed.us)",
  "homepage": "https://thegeekshed.us",
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --target=node22 --outfile=dist/main/index.js --external:electron",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --target=node22 --outfile=dist/preload/index.js --external:electron",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "start": "npm run build && electron .",
    "start:fast": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist": "npm run build && electron-builder -mw"
  },
  "build": {
    "appId": "org.thegeekshed.astrosquad",
    "productName": "AstroSquad Station",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AstroSquad Station",
      "uninstallDisplayName": "AstroSquad Station"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education",
      "artifactName": "${productName}-${version}-mac.${ext}"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "@extend-ai/react-pptx": "^0.2.1",
    "isomorphic-git": "^1.27.1",
    "jszip": "^3.10.1",
    "katex": "^0.16.11",
    "lucide-react": "^0.475.0",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-katex": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^22.10.1",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.0",
    "postcss": "^8.4.49",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
